    "catalog:ecs:collect-sitemaps": "node scripts/ecs-catalog/collect-sitemaps.mjs",
    "catalog:ecs:url-manifests": "node scripts/ecs-catalog/build-url-manifests.mjs",
    "catalog:ecs:shards": "node scripts/ecs-catalog/shard-jobs.mjs",
    "catalog:ecs:publish-discovery": "node scripts/ecs-catalog/publish-discovery-blob.mjs",
