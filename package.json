{
  "name": "projx-racing-website",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual English–Arabic production website for Projx Racing Co., Kuwait, with light and dark themes.",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test:api": "node scripts/test-api.mjs && node scripts/test-tegiwa-catalog-api.mjs && node scripts/test-parts-catalog-api.mjs",
    "catalog:prepare": "node scripts/catalog-import.mjs",
    "catalog:ecs:prepare": "node scripts/ecs-catalog/ingest.mjs",
    "catalog:tegiwa-stock": "node scripts/build-tegiwa-stock-index.mjs",
    "catalog:tegiwa-sitemaps": "node scripts/build-tegiwa-sitemap-manifest.mjs",
    "catalog:tegiwa-snapshot": "node scripts/build-tegiwa-catalog-snapshot.mjs",
    "catalog:tegiwa-search": "node scripts/build-tegiwa-search-index.mjs",
    "catalog:tegiwa:neon:dry-run": "node scripts/neon-catalog/import-tegiwa.mjs --dry-run",
    "vehicles:validate": "node scripts/validate-tegiwa-vehicle-directory.mjs",
    "test:ecs-catalog": "node --test scripts/ecs-catalog/test.mjs",
    "test:neon-import": "node --test scripts/neon-catalog/test.mjs",
    "test:blob-publisher": "node --test scripts/vendor-sync/publish-vercel-blob.test.mjs",
    "test:customer-commerce": "node --test scripts/test-customer-commerce.mjs",
    "test:staging-commerce": "node scripts/test-staging-commerce.mjs",
    "test:account-ui": "node --test scripts/test-account-dashboard-ui.mjs",
    "test:unified-catalogue-ui": "node scripts/test-unified-catalogue-ui.mjs",
    "test": "npm run test:api && npm run test:ecs-catalog && npm run test:neon-import && npm run test:blob-publisher && npm run test:customer-commerce && npm run test:staging-commerce && npm run test:account-ui && npm run test:unified-catalogue-ui",
    "check": "npm run lint && npm run build && npm run validate && npm run vehicles:validate && npm run test",
    "preview": "node scripts/serve.mjs dist 4173"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.4.0"
  }
}
