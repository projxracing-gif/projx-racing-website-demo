# Secure account portal and Vercel email delivery.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
COMMERCE_FROM_EMAIL=
SHOP_NOTIFICATION_EMAIL=
COMMERCE_OUTBOX_RETRY_SECRET=

# Keep both false until a durable WAF/rate limit or managed CAPTCHA is live and verified.
# PUBLIC_FORM_ANTI_ABUSE_READY gates all public guest-form email delivery.
# STAGING_ORDER_EMAIL_DELIVERY_ENABLED opts staging checkout into email after that gate is ready.
PUBLIC_FORM_ANTI_ABUSE_READY=false
STAGING_ORDER_EMAIL_DELIVERY_ENABLED=false

# Server-only connection for the unified parts catalogue.
DATABASE_URL=

# Optional server-only public manifest for verified Tegiwa stock releases.
TEGIWA_STOCK_MANIFEST_URL=
# Preferred keyless Vercel Blob credentials. Vercel injects the OIDC token;
# `vercel env pull` provides a short-lived local value. Both values are required together.
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=
# Legacy server-only Blob credential fallback.
BLOB_READ_WRITE_TOKEN=
TEGIWA_STOCK_MANIFEST_SECRET=

# Server-only credentials for the preview ECS URL-discovery release publisher.
# This publisher cannot target production and never uploads dealer/private product data.
ECS_DISCOVERY_ENABLED=false
ECS_DISCOVERY_CURRENT_URL=
ECS_DISCOVERY_MANIFEST_SECRET=

# Server-only pointer and signing secret for the verified preview ECS product shards.
ECS_REVIEWED_SHARD_CURRENT_URL=
ECS_REVIEWED_SHARD_MANIFEST_SECRET=

# Server-only supplier shipping foundation. Empty modes are fail-closed.
SUPPLIER_SHIPPING_MODE=
SUPPLIER_SHIPPING_ALLOWED_COUNTRIES=
SUPPLIER_SHIPPING_QUOTE_SIGNING_SECRET=
SUPPLIER_SHIPPING_MAX_QUOTE_AGE_SECONDS=
SUPPLIER_SHIPPING_PROVIDER_TIMEOUT_MS=
SUPPLIER_SHIPPING_FX_MAX_AGE_SECONDS=
SUPPLIER_SHIPPING_FX_FUTURE_SKEW_SECONDS=
SUPPLIER_SHIPPING_TARGET_CURRENCY=
SUPPLIER_SHIPPING_PERSIST_QUOTES=
SUPPLIER_SHIPPING_ALERT_RECIPIENT=

# Server-only commercial-rule controls. All rules remain disabled unless the
# enabled flag is explicitly set after review; amounts use target-currency minor units.
SUPPLIER_SHIPPING_COMMERCIAL_RULES_ENABLED=
SUPPLIER_SHIPPING_HANDLING_BPS=
SUPPLIER_SHIPPING_MINIMUM_HANDLING_MINOR=
SUPPLIER_SHIPPING_FX_PROTECTION_BPS=
SUPPLIER_SHIPPING_INSURANCE_BPS=
SUPPLIER_SHIPPING_FRAGILE_FEE_MINOR=
SUPPLIER_SHIPPING_OVERSIZE_FEE_MINOR=
SUPPLIER_SHIPPING_FORWARDER_FEE_MINOR=
SUPPLIER_SHIPPING_LOCAL_DELIVERY_FEE_MINOR=
SUPPLIER_SHIPPING_ROUNDING_INCREMENT_MINOR=
SUPPLIER_SHIPPING_MANUAL_REVIEW_THRESHOLD_MINOR=
SUPPLIER_SHIPPING_MAX_REVALIDATION_DELTA_MINOR=
SUPPLIER_SHIPPING_MAX_REVALIDATION_DELTA_BPS=

# Tegiwa adapter names are reserved for a supplier-authorised implementation.
TEGIWA_INTEGRATION_MODE=
TEGIWA_QUOTE_API_URL=
TEGIWA_QUOTE_API_TOKEN=
TEGIWA_SHOP_DOMAIN=
TEGIWA_STOREFRONT_ACCESS_TOKEN=
TEGIWA_ORDER_API_URL=
TEGIWA_ORDER_API_TOKEN=
TEGIWA_ACCOUNT_REFERENCE=
TEGIWA_WEBHOOK_SECRET=

# ECS adapter names are reserved for a supplier-authorised implementation.
ECS_INTEGRATION_MODE=
ECS_QUOTE_API_URL=
ECS_QUOTE_API_TOKEN=
ECS_ORDER_API_URL=
ECS_ORDER_API_TOKEN=
ECS_ACCOUNT_REFERENCE=
ECS_WEBHOOK_SECRET=

# Protected shipping-readiness administration. Clerk identity is necessary but
# not sufficient; the server-side user or role allowlist must also match.
SHIPPING_ADMIN_CLERK_USER_IDS=
SHIPPING_ADMIN_CLERK_ROLES=
