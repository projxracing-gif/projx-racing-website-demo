# Secure account portal and Vercel email delivery.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
COMMERCE_FROM_EMAIL=
SHOP_NOTIFICATION_EMAIL=
COMMERCE_OUTBOX_RETRY_SECRET=

# Keep both false until a durable WAF/rate limit or managed CAPTCHA is live and verified.
# PUBLIC_FORM_ANTI_ABUSE_READY gates all public guest-form email delivery.
# STAGING_ORDER_EMAIL_DELIVERY_ENABLED opts staging checkout into email after that gate is ready.
PUBLIC_FORM_ANTI_ABUSE_READY=false
STAGING_ORDER_EMAIL_DELIVERY_ENABLED=false

# Server-only connection for the unified parts catalogue.
DATABASE_URL=

# Optional server-only public manifest for verified Tegiwa stock releases.
TEGIWA_STOCK_MANIFEST_URL=
# Preferred keyless Vercel Blob credentials. Vercel injects the OIDC token;
# `vercel env pull` provides a short-lived local value. Both values are required together.
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=
# Legacy server-only Blob credential fallback.
BLOB_READ_WRITE_TOKEN=
TEGIWA_STOCK_MANIFEST_SECRET=

# Server-only credentials for the preview ECS URL-discovery release publisher.
# This publisher cannot target production and never uploads dealer/private product data.
ECS_DISCOVERY_ENABLED=false
ECS_DISCOVERY_CURRENT_URL=
ECS_DISCOVERY_MANIFEST_SECRET=

# Server-only pointer and signing secret for the verified preview ECS product shards.
ECS_REVIEWED_SHARD_CURRENT_URL=
ECS_REVIEWED_SHARD_MANIFEST_SECRET=
